{
  "name": "mrbro.dev",
  "version": "0.0.0",
  "description": "My portfolio.",
  "keywords": [
    "portfolio",
    "developer",
    "blog",
    "vite",
    "typescript",
    "react",
    "github-pages"
  ],
  "homepage": "https://mrbro.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcusrbrown/marcusrbrown.github.io.git"
  },
  "license": "MIT",
  "author": "Marcus R. Brown <marcus@mrbro.dev>",
  "type": "module",
  "main": "src/main.tsx",
  "scripts": {
    "build": "pnpm run check-types && vite build && tsx --import ./scripts/register-blog-snapshot-loader.mjs scripts/prerender-blog.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p .opencode/tsconfig.json",
    "dev": "vite",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "setup-hooks": "simple-git-hooks",
    "analyze-build": "tsx scripts/analyze-build.ts",
    "blog-refresh": "tsx scripts/blog-refresh.ts",
    "security:react-router-rsc": "tsx scripts/check-react-router-rsc-boundary.ts",
    "project-preview-refresh": "tsx scripts/project-preview-refresh.ts",
    "projects-refresh": "tsx scripts/projects-refresh.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen",
    "test:accessibility": "playwright test --project=accessibility",
    "test:accessibility:headed": "playwright test --project=accessibility --headed",
    "test:visual": "playwright test --project=visual-tests",
    "test:visual:headed": "playwright test --project=visual-tests --headed",
    "test:visual:update": "playwright test --project=visual-tests --update-snapshots",
    "test:visual:artifacts": "node scripts/visual-artifact-manager.mjs",
    "test:visual:artifacts:clean": "node scripts/visual-artifact-manager.mjs clean",
    "test:visual:artifacts:analyze": "node scripts/visual-artifact-manager.mjs analyze",
    "test:visual:artifacts:report": "node scripts/visual-artifact-manager.mjs report",
    "test:performance": "lhci autorun",
    "test:performance:mobile": "lhci autorun --config=lhci-mobile.config.cjs",
    "test:performance:desktop": "lhci autorun --config=lhci-desktop.config.cjs",
    "test:performance:budgets": "tsx scripts/performance-budgets.ts",
    "test:performance:regression": "tsx scripts/performance-regression.ts",
    "test:performance:dashboard": "tsx scripts/performance-dashboard.ts",
    "test:performance:artifacts": "tsx scripts/performance-artifacts.ts",
    "test:performance:full": "pnpm run test:performance && pnpm run test:performance:budgets && pnpm run test:performance:dashboard && pnpm run test:performance:artifacts",
    "test:all": "vitest run && playwright test",
    "badges": "node scripts/generate-test-badges.mjs",
    "badges:update": "pnpm run test -- --coverage && pnpm run badges",
    "dashboard": "node scripts/test-dashboard.mjs",
    "dashboard:update": "pnpm run test:all && pnpm run dashboard",
    "configure:branch-protection": "tsx scripts/configure-branch-protection.ts",
    "configure:repo-settings": "tsx scripts/apply-repo-settings.ts",
    "artifacts": "node scripts/artifact-management.mjs",
    "artifacts:cleanup": "node scripts/artifact-management.mjs cleanup",
    "artifacts:optimize": "node scripts/artifact-management.mjs optimize",
    "artifacts:full": "node scripts/artifact-management.mjs full"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "node .github/git-hooks/pre-push.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yaml}": [
      "eslint --fix"
    ]
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "feed": "6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@bfra.me/eslint-config": "0.51.1",
    "@bfra.me/prettier-config": "0.16.9",
    "@bfra.me/tsconfig": "0.13.1",
    "@eslint-react/eslint-plugin": "2.13.0",
    "@lhci/cli": "0.15.1",
    "@opencode-ai/plugin": "1.18.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.23",
    "agent-browser": "0.33.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "happy-dom": "20.10.6",
    "jiti": "2.7.0",
    "lint-staged": "16.4.0",
    "playwright": "1.61.1",
    "prettier": "3.9.5",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.3.1",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.3"
  }
}
