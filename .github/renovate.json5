{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // 'group:allNonMajor' is intentionally omitted here: the base preset already extends it,
  // and re-adding it here (as a later extend) overrides the preset's own
  // 'Ungroup unstable (v0.x[.x]) packages' rule, re-gating the whole group behind
  // dependencyDashboardApproval for any 0.x member.
  extends: ['github>marcusrbrown/renovate-config#5.2.13'],
  postUpgradeTasks: {
    commands: ['pnpm install', 'pnpm run build', 'pnpm run fix', 'pnpm run fix'],
    executionMode: 'branch',
  },
}
